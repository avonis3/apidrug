<script>
var showScreen=function(id,opts){
  opts=opts||{};
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
  var el=document.getElementById(id);
  if(!el){console.error('Screen not found:',id);return;}
  el.classList.add('active');
  window.scrollTo(0,0);
  var dd=document.getElementById('accountDropdown');
  if(dd) dd.classList.remove('open');
  if(id==='screen-plp'){
    if(opts.cat) currentCat=opts.cat;
    document.querySelectorAll('.subcat-item').forEach(function(p){
      p.classList.toggle('active',p.dataset.cat===currentCat);
    });
    if(typeof renderProducts==='function') renderProducts();
  }
  if(id==='screen-cart'&&typeof render==='function'){render();}
  if(id==='screen-checkout'&&typeof init_checkout==='function'){init_checkout();}

  if(id==='screen-payment'&&typeof renderPaymentPanel==='function'){renderPaymentPanel();}
  if(id==='screen-order-confirm'){
    var oid=localStorage.getItem('apiLastOrderId');
    if(oid){['orderIdDisplay','orderIdDetail','confirmOrderId'].forEach(function(eid){
      var e2=document.getElementById(eid);if(e2)e2.textContent=oid;
    });}
  }
  if(id==='screen-orders'&&typeof init_orders==='function'){init_orders();}
  if(id==='screen-kyc'&&typeof init_kyc==='function'){init_kyc();}
};

// ===== SHARED FUNCTIONS =====
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.classList.add('show');
  clearTimeout(toastT);
  toastT=setTimeout(()=>t.classList.remove('show'),3000);
}
function updateCartBadge(){
  try{
    const c=JSON.parse(localStorage.getItem('apiCart')||'[]');
    const total=c.reduce((s,i)=>s+i.qty,0);
    document.getElementById('cartBadge').textContent=total||0;
  }catch(e){}
}
function updateNavLogin(){
  const loginBtn = document.getElementById('loginNavBtn');
  const acctArea = document.getElementById('navAccount');
  if(isLoggedIn){
    if(loginBtn) loginBtn.style.display='none';
    if(acctArea) acctArea.style.display='flex';
    updateKycChip();
  } else {
    if(loginBtn) loginBtn.style.display='flex';
    if(acctArea) acctArea.style.display='none';
  }
}
function openLoginModal(){
  document.getElementById('loginModal').classList.add('open');
  setTimeout(()=>{ const inp=document.getElementById('loginInput'); if(inp) inp.focus(); },100);
}
function closeLoginModal(){
  document.getElementById('loginModal').classList.remove('open');
  document.getElementById('loginInput').value='';
}
function doLogin(){
  const val = document.getElementById('loginInput').value.trim();
  if(!val){ showToast('Please enter your phone number or email.'); return; }
  localStorage.setItem('apiLoggedIn','1');
  isLoggedIn = true;
  closeLoginModal();
  showToast('OTP sent. You are now logged in (demo)');
  updateNavLogin();
}
function openPincodeModal(){
  document.getElementById('pincodeOverlay').classList.add('open');
  const saved = localStorage.getItem('apiPincode') || '';
  document.getElementById('pincodeInput').value = saved;
  updateSaveBtn();
}
function closePincodeModal(e){
  if(!e || e.target===document.getElementById('pincodeOverlay'))
    document.getElementById('pincodeOverlay').classList.remove('open');
}
function savePincode(){
  const val = document.getElementById('pincodeInput').value.trim();
  if(val.length<6) return;
  localStorage.setItem('apiPincode',''+val);
  document.getElementById('navPincodeDisplay').textContent = val;
  document.getElementById('pincodeOverlay').classList.remove('open');
  showToast('Location updated to '+val);
}
function updateKycChip(){
  const chip = document.getElementById('acctKycChip');
  if(!chip) return;
  const s = localStorage.getItem('apiKycStatus')||'none';
  if(s==='approved'){chip.className='acct-kyc-chip verified';chip.innerHTML='<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="#2e7d32" stroke-width="2"><circle cx="8" cy="8" r="6.5"/><polyline points="5,8 7,10 11,6"/></svg> KYC Verified';}
  else if(s==='pending'){chip.className='acct-kyc-chip pending';chip.innerHTML='<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="#E86A18" stroke-width="2"><circle cx="8" cy="8" r="6.5"/><polyline points="8,4 8,8 11,10"/></svg> KYC Under Review';}
  else{chip.className='acct-kyc-chip none';chip.innerHTML='<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="#888" stroke-width="2"><circle cx="8" cy="8" r="6.5"/><circle cx="8" cy="8" r="2.5" fill="#888" stroke="none"/></svg> KYC Not Started';}
}
function checkPincode(){
  const val = document.getElementById('pincodeInput').value.trim();
  if(val.length===6) showToast('Pincode '+val+' is serviceable!');
  else showToast('Please enter a valid 6-digit pincode');
}
function updateSaveBtn(){
  const val = document.getElementById('pincodeInput').value.trim();
  const btn = document.getElementById('pincodeSaveBtn');
  btn.classList.toggle('active', val.length>=6);
}
function toggleLocation(){
  const sw = document.getElementById('locationToggle');
  sw.classList.toggle('on');
  if(sw.classList.contains('on')){
    if(navigator.geolocation){
      navigator.geolocation.getCurrentPosition(function(){
        document.getElementById('pincodeInput').value='400001';
        updateSaveBtn();
        showToast('Location detected: 400001 (demo)');
      },function(){showToast('Could not detect location');sw.classList.remove('on');});
    }
  }
}
var currentCurrency = localStorage.getItem('apiCurrency') || 'INR';
var USD_RATE = 96; // 1 USD = 96 INR
function fmt(n){
  if(currentCurrency === 'USD'){
    return '$ ' + (n / USD_RATE).toFixed(2);
  }
  return '₹' + (n||0).toLocaleString('en-IN');
}
function fmtUnitPrice(n, unit){
  if(currentCurrency === 'USD'){
    return '$ ' + (n / USD_RATE).toFixed(2) + ' / ' + unit;
  }
  return '₹' + (n||0).toLocaleString('en-IN') + ' / ' + unit;
}
function toggleCurrencyDropdown(e){
  if(e) e.stopPropagation();
  var dd = document.getElementById('currDropdown');
  dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
}
function setCurrency(code){
  currentCurrency = code;
  localStorage.setItem('apiCurrency', code);
  document.getElementById('currDropdown').style.display = 'none';
  var sym = code === 'USD' ? '$' : '₹';
  document.getElementById('currSymbolBtn').textContent = sym;
  document.getElementById('currLabelBtn').textContent = code;
  // Re-render all active screens
  if(typeof renderProducts === 'function') renderProducts();
  if(typeof render === 'function') render();
  if(typeof renderSummary === 'function') renderSummary();
}
// Close dropdown on outside click
document.addEventListener('click', function(e){
  var dd = document.getElementById('currDropdown');
  if(dd && dd.style.display !== 'none'){
    var wrap = document.getElementById('navCurrencyWrap');
    if(wrap && !wrap.contains(e.target)) dd.style.display = 'none';
  }
});
function autoFillAll(){
  Object.keys(DEMO_FILENAMES).forEach(docId => {
    markUploaded(docId, DEMO_FILENAMES[docId]);
  });
  showToast('All documents auto-filled for demo');
}
function handleUpload(docId, input){
  if(!input.files || !input.files[0]) return;
  const file = input.files[0];
  markUploaded(docId, file.name);
}
function markUploaded(docId, filename){
  uploadedDocs[docId] = filename;
  const item = document.getElementById('doc-'+docId);
  item.classList.add('uploaded');
  document.getElementById('fn-'+docId+'-name').textContent = filename;
  document.getElementById('fn-'+docId).style.display = 'flex';
  document.getElementById('ub-'+docId).textContent = 'Change';
  document.getElementById('rb-'+docId).style.display = 'inline-block';
  updateProgress();
}
function removeDoc(docId){
  delete uploadedDocs[docId];
  const item = document.getElementById('doc-'+docId);
  item.classList.remove('uploaded');
  document.getElementById('fn-'+docId).style.display = 'none';
  document.getElementById('fi-'+docId).value = '';
  document.getElementById('ub-'+docId).textContent = 'Upload';
  document.getElementById('rb-'+docId).style.display = 'none';
  updateProgress();
}
function submitKYC(){
  localStorage.setItem('apiKycStatus','pending');
  localStorage.setItem('apiKycSubmittedAt', new Date().toISOString());
  showToast('Documents submitted successfully');
  setTimeout(showPending, 600);
}
function simulateApproval(){
