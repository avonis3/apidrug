function placeOrder(){
  var orderId = 'APID-' + Math.floor(100000 + Math.random() * 900000);
  var cart = JSON.parse(localStorage.getItem('apiCart') || '[]');
  var payMode = localStorage.getItem('apiPaymentMethod') || 'card';

  var newOrder = {
    id: orderId,
    date: new Date().toISOString(),
    status: 'processing',
    items: cart.map(function(item){
      return {
        name: item.molecule || item.name || 'API Product',
        mfr: item.mfr || '',
        unit: item.unit || 'KG',
        qty: item.qty || 1,
        price: (item.price || 0) * (item.qty || 1)
      };
    }),
    amount: savedTotal,
    itemCount: cart.length || 1,
    paymentMode: payMode
  };

  var existingOrders = JSON.parse(localStorage.getItem('apiOrders') || '[]');
  existingOrders.unshift(newOrder);
  localStorage.setItem('apiOrders', JSON.stringify(existingOrders));

  var savedTotal = parseInt(localStorage.getItem('apiCheckoutTotal') || '0') || grandTotal || 0;
  localStorage.setItem('apiOrderId',orderId);
  localStorage.setItem('apiLastOrderId',orderId);
  localStorage.setItem('apiOrderTotal', savedTotal);
  localStorage.setItem('apiOrderDate', new Date().toISOString());
  localStorage.removeItem('apiCart');
  localStorage.removeItem('apiCoupon');
  localStorage.removeItem('apiCheckoutTotal');
  localStorage.removeItem('apiCheckoutItems');
  localStorage.removeItem('apiPaymentMethod');
  showToast('Processing payment...');
  setTimeout(function(){ showScreen('screen-order-confirm'); }, 1200);
}






