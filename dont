<style>
.screen{display:none!important;}
.screen.active{display:block!important;}

  /* Inquiry thank-you overlay */
  .inq-thankyou {
    position:absolute; inset:0; background:rgba(40,40,40,0.96);
    border-radius:16px; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:16px; padding:32px;
    z-index:10;
  }
  .inquiry-right { position:relative; }
  .inq-ty-icon svg { width:72px; height:72px; display:block; }
  .inq-ty-title { color:#fff; font-size:26px; font-weight:700; margin:0; }
  .inq-ty-msg { color:#ddd; font-size:15px; text-align:center; margin:0; line-height:1.6; }


  /* Currency dropdown */
  .nav-currency { position:relative; }
  .curr-btn {
    display:flex; align-items:center; gap:4px; padding:6px 10px;
    background:#fff; border:1.5px solid #e0e0e0; border-radius:8px;
    font-size:13px; font-weight:600; color:#333; cursor:pointer;
    transition:border-color .2s;
  }
  .curr-btn:hover { border-color:#E86A18; }
  .curr-dropdown {
    position:absolute; right:0; top:calc(100% + 6px); background:#fff;
    border:1px solid #e0e0e0; border-radius:10px; box-shadow:0 6px 24px rgba(0,0,0,.12);
    z-index:200; min-width:190px; overflow:hidden;
  }
  .curr-opt {
    display:flex; align-items:center; gap:10px; padding:12px 16px;
    font-size:13px; color:#333; cursor:pointer; transition:background .15s;
  }
  .curr-opt:hover { background:#fff8f3; }
  .curr-opt-sym { font-weight:700; color:#E86A18; font-size:15px; width:18px; }


  /* Map strip */
  .map-strip { margin:0; background:#fff; border-bottom:1px solid #eef0f4; }
  .map-strip-inner { position:relative; width:100%; overflow:hidden; height:120px; }
  .map-bg { width:100%; height:120px; display:block; }
  .map-live-badge {
    position:absolute; top:10px; left:12px; background:rgba(26,46,90,.85);
    color:#fff; font-size:11px; font-weight:600; padding:4px 10px;
    border-radius:20px; display:flex; align-items:center; gap:6px;
  }
  .map-pulse {
    width:8px; height:8px; background:#4caf50; border-radius:50%;
    animation:pulse-dot 1.4s infinite;
  }
  @keyframes pulse-dot {
    0%,100%{ box-shadow:0 0 0 0 rgba(76,175,80,.5); }
    50%{ box-shadow:0 0 0 5px rgba(76,175,80,0); }
  }
  .awb-row {
    display:flex; align-items:center; gap:10px; padding:10px 16px;
    background:#f8f9fc; border-top:1px solid #eef0f4;
  }
  .awb-label { font-size:12px; color:#888; font-weight:500; }
  .awb-val { font-size:13px; font-weight:700; color:#1a2e5a; letter-spacing:.5px; }
  .awb-copy {
    background:none; border:1.5px solid #dde; border-radius:6px;
    padding:3px 6px; cursor:pointer; color:#666; display:flex; align-items:center;
  }
  .awb-copy:hover { border-color:#E86A18; color:#E86A18; }

</style>
<style>
* {box-sizing:border-box;margin:0;padding:0;}
body {font-family:Arial,sans-serif;color:#333;background:#fff;font-size:14px;}
/* NAVBAR */
.nav {background:#fff;border-bottom:1px solid #e0e0e0;padding:0 28px;height:58px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:100;}
.nav-logo {display:flex;align-items:center;gap:8px;text-decoration:none;flex-shrink:0;}
.nav-logo-icon {width:34px;height:34px;background:#E86A18;border-radius:6px;display:flex;align-items:center;justify-content:center;}
.nav-logo-icon svg {width:22px;height:22px;}
.nav-logo-text {font-size:17px;font-weight:800;letter-spacing:0.3px;color:#1a2e5a;}
.nav-logo-text span {color:#E86A18;}
.nav-location {display:flex;align-items:center;gap:5px;font-size:12px;color:#555;white-space:nowrap;flex-shrink:0;padding:5px 10px;border:1px solid #e0e0e0;border-radius:20px;}
.nav-location:hover {background:#f5f5f5;}
.nav-location span {color:#333;font-weight:600;}
/* Pincode Modal */
.pincode-overlay {display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:2000;align-items:center;justify-content:center;}
.pincode-overlay.open {display:flex;}
.pincode-modal {background:#fff;border-radius:20px;width:90%;max-width:440px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.25);}
.pincode-modal-body {padding:32px 28px 24px;}
.pincode-modal-title {font-size:26px;font-weight:800;color:#1a1a1a;margin-bottom:24px;}
.pincode-toggle-row {display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px;}
.pincode-toggle-left {}
.pincode-toggle-label {font-size:15px;font-weight:600;color:#1a1a1a;}
.pincode-toggle-sub {font-size:12px;color:#888;margin-top:4px;}
.toggle-sw {flex-shrink:0;width:50px;height:28px;background:#ccc;border-radius:14px;position:relative;cursor:pointer;transition:background .2s;margin-top:2px;}
.toggle-sw.on {background:#2e7d32;}
.toggle-sw::after {content:'';position:absolute;top:3px;left:3px;width:22px;height:22px;background:#fff;border-radius:50%;transition:transform .2s;box-shadow:0 1px 4px rgba(0,0,0,0.2);}
.toggle-sw.on::after {transform:translateX(22px);}
.pincode-input-row {display:flex;align-items:center;border:1.5px solid #d0d0d0;border-radius:30px;padding:0 6px 0 18px;margin-bottom:4px;}
.pincode-input-row input {flex:1;border:none;outline:none;font-size:15px;color:#1a1a1a;padding:13px 0;background:transparent;}
.pincode-check-btn {background:none;border:none;color:#1a2e5a;font-size:14px;font-weight:700;cursor:pointer;padding:8px 14px;}
.pincode-check-btn:hover {text-decoration:underline;}
.pincode-modal-footer {background:#f5f5f7;padding:16px 28px;}
.pincode-save-btn {width:100%;background:#e0e0e0;color:#aaa;border:1.5px solid #d0d0d0;border-radius:30px;padding:14px;font-size:15px;font-weight:700;cursor:not-allowed;transition:all .2s;}
.pincode-save-btn.active {background:#1a2e5a;color:#fff;border-color:#1a2e5a;cursor:pointer;}
.nav-login {background:#1a2e5a;color:#fff;border:none;padding:8px 16px;border-radius:4px;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;flex-shrink:0;display:flex;align-items:center;gap:6px;}
.nav-login svg {width:15px;height:15px;}
.nav-cart {display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#333;font-size:11px;flex-shrink:0;position:relative;}
.nav-cart svg {width:22px;height:22px;}
.cart-badge {position:absolute;top:-4px;right:-6px;background:#E86A18;color:#fff;border-radius:50%;width:16px;height:16px;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:700;}
/* HERO */
.hero {position:relative;min-height:400px;display:flex;align-items:center;overflow:hidden;background:#0d1e3d;}
.hero-bg {position:absolute;inset:0;background:
    linear-gradient(to right,rgba(10,20,50,0.88) 45%,rgba(10,20,50,0.45) 100%),
    url('https://images.unsplash.com/photo-1582719471137-c3967ffb1c42?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
  }
.hero-content {position:relative;z-index:2;padding:60px 60px 60px 60px;max-width:620px;}
.hero-title {font-size:46px;font-weight:800;color:#fff;line-height:1.15;margin-bottom:28px;}
.hero-cta {background:#E86A18;color:#fff;border:none;padding:14px 28px;border-radius:6px;font-size:13px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;cursor:pointer;transition:background 0.15s;}
.hero-cta:hover {background:#d05a10;}
/* CATEGORY TILES */
.cats-strip {background:#fff;border-bottom:1px solid #e0e0e0;display:flex;align-items:stretch;}
.cat-tile {flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:26px 16px;cursor:pointer;text-decoration:none;color:#333;border-right:1px solid #e0e0e0;transition:background 0.15s;}
.cat-tile:last-child {border-right:none;}
.cat-tile:hover {background:#fff8f4;}
.cat-tile:hover .cat-name {color:#E86A18;}
.cat-icon {width:52px;height:52px;margin-bottom:10px;}
.cat-name {font-size:14px;font-weight:500;color:#444;}
/* INQUIRY SECTION */
.inquiry-section {padding:70px 60px;display:flex;align-items:center;gap:80px;background:#fff;}
.inquiry-left {flex:1;}
.inquiry-left h2 {font-size:32px;font-weight:700;color:#1a2e5a;line-height:1.3;margin-bottom:24px;}
.inquiry-left h2 span {color:#E86A18;}
.inquiry-badge {display:inline-block;background:#E86A18;color:#fff;padding:10px 22px;border-radius:6px;font-size:13px;font-weight:600;margin-bottom:30px;}
.inquiry-contact {display:flex;flex-direction:column;gap:14px;}
.contact-item {display:flex;align-items:center;gap:12px;font-size:14px;color:#555;}
.contact-icon {width:36px;height:36px;background:#f0f0f0;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.contact-icon svg {width:16px;height:16px;color:#555;}
.inquiry-right {flex:0 0 460px;}
.form-card {background:#4a4a4a;border-radius:10px;padding:32px;color:#fff;}
.form-card h3 {font-size:22px;font-weight:700;margin-bottom:6px;}
.form-card p {font-size:13px;color:rgba(255,255,255,0.75);margin-bottom:24px;}
.form-row {display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
.form-group {display:flex;flex-direction:column;gap:5px;}
.form-group.full {grid-column:1/-1;}
.form-group label {font-size:12px;color:rgba(255,255,255,0.8);}
.form-group input,.form-group textarea {
    background:#fff;border:none;border-radius:4px;padding:10px 12px;font-size:13px;color:#333;outline:none;font-family:Arial,sans-serif;
  }
.form-group input::placeholder,.form-group textarea::placeholder {color:#aaa;}
.form-group textarea {resize:vertical;min-height:90px;}
.form-submit {background:#E86A18;color:#fff;border:none;padding:11px 24px;border-radius:5px;font-size:13px;font-weight:700;cursor:pointer;margin-top:8px;transition:background 0.15s;}
.form-submit:hover {background:#d05a10;}
/* FEATURES */
.features-section {background:#f7f9fc;padding:60px;}
.features-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:1100px;margin:0 auto;}
.feature-card {background:#fff;border-radius:8px;padding:28px;border:1px solid #e8ecf0;}
.feature-icon {width:48px;height:48px;background:#fff5ee;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;}
.feature-icon svg {width:26px;height:26px;color:#E86A18;}
.feature-card h4 {font-size:15px;font-weight:700;color:#1a2e5a;margin-bottom:8px;}
.feature-card p {font-size:13px;color:#666;line-height:1.6;}
/* FOOTER */
.footer {background:#1a2e5a;color:rgba(255,255,255,0.7);padding:36px 60px;display:flex;align-items:center;justify-content:space-between;font-size:13px;}
.footer-logo {display:flex;align-items:center;gap:8px;}
.footer-logo-text {color:#fff;font-weight:700;font-size:15px;}
.footer-logo-text span {color:#E86A18;}
.footer-links {display:flex;gap:24px;}
.footer-links a {color:rgba(255,255,255,0.65);text-decoration:none;}
.footer-links a:hover {color:#fff;}
.footer-copy {color:rgba(255,255,255,0.5);}
/* SUCCESS TOAST */
.toast {position:fixed;bottom:24px;right:24px;background:#1a2e5a;color:#fff;padding:12px 20px;border-radius:6px;font-size:13px;opacity:0;transform:translateY(12px);transition:all 0.25s;pointer-events:none;z-index:999;}
.toast.show {opacity:1;transform:translateY(0);}
/* ACCOUNT DROPDOWN */
.nav-account {position:relative;flex-shrink:0;}
.nav-acct-btn {background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;color:#333;padding:4px 8px;border-radius:4px;flex-shrink:0;}
.nav-acct-btn:hover {background:#f4f6f8;}
.nav-acct-btn svg {width:24px;height:24px;}
.nav-acct-btn span {font-size:11px;font-weight:500;color:#333;}
.account-dropdown {display:none;position:absolute;top:calc(100% + 8px);right:0;background:#fff;border:1px solid #e0e0e0;border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,0.14);min-width:270px;z-index:200;overflow:hidden;}
.account-dropdown.open {display:block;}
.acct-kyc-chip {display:flex;align-items:center;gap:8px;padding:12px 16px;font-size:13px;font-weight:600;border-bottom:1px solid #f0f0f0;}
.acct-kyc-chip.verified {color:#2e7d32;background:#f0faf2;}
.acct-kyc-chip.pending {color:#E86A18;background:#fff8f0;}
.acct-kyc-chip.none {color:#888;background:#f7f7f7;}
.dropdown-item {display:flex;align-items:flex-start;gap:12px;padding:13px 16px;font-size:13px;color:#333;text-decoration:none;cursor:pointer;border-bottom:1px solid #f5f5f5;}
.dropdown-item:last-child {border-bottom:none;}
.dropdown-item:hover {background:#f7f9fc;}
.dropdown-item-icon {width:18px;height:18px;flex-shrink:0;margin-top:1px;stroke:#555;fill:none;}
.dropdown-item-text {flex:1;}
.dropdown-item-title {font-size:13px;font-weight:600;color:#1a1a1a;}
.dropdown-item-sub {font-size:11px;color:#999;margin-top:2px;}
.dropdown-item-arrow {color:#ccc;font-size:18px;line-height:1.2;}
.dropdown-logout .dropdown-item-title {color:#e53935;}
.dropdown-logout:hover {background:#fff5f5 !important;}
/* KYC STATUS BANNER */
.kyc-status-section {padding:48px 60px;}
.kyc-banner {max-width:1100px;margin:0 auto;border-radius:12px;padding:20px 28px;display:flex;align-items:center;gap:20px;box-shadow:0 2px 12px rgba(0,0,0,0.06);}
.kyc-banner.pending {background:#fffbf0;border:1.5px solid #ffe082;border-left:5px solid #E86A18;}
.kyc-banner.approved {background:#f0faf2;border:1.5px solid #c8e6c9;border-left:5px solid #2e7d32;}
.kyc-banner.none {background:#fff5f5;border:1.5px solid #ffcdd2;border-left:5px solid #e53935;}
.kyc-banner.none .kyc-banner-icon {background:#fce4ec;}
.kyc-banner.none .kyc-banner-title {color:#c62828;}
.kyc-demo-toggle {display:flex;align-items:center;gap:5px;flex-shrink:0;background:rgba(0,0,0,0.06);border-radius:20px;padding:5px 10px;}
.kyc-demo-label {font-size:10px;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:0.6px;margin-right:2px;}
.kyc-demo-btn {border:1px solid #d0d0d0;background:#fff;border-radius:20px;padding:4px 11px;font-size:11px;font-weight:600;color:#555;cursor:pointer;transition:all .15s;}
.kyc-demo-btn:hover {border-color:#999;}
.kyc-demo-btn.active {background:#1a2e5a;color:#fff;border-color:#1a2e5a;}
.kyc-banner-icon {width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.kyc-banner.pending .kyc-banner-icon {background:#fff3e0;}
.kyc-banner.approved .kyc-banner-icon {background:#e8f5e9;}
.kyc-banner-icon svg {width:26px;height:26px;}
.kyc-banner-body {flex:1;}
.kyc-banner-title {font-size:16px;font-weight:700;margin-bottom:4px;}
.kyc-banner.pending .kyc-banner-title {color:#E86A18;}
.kyc-banner.approved .kyc-banner-title {color:#2e7d32;}
.kyc-banner-sub {font-size:13px;color:#555;line-height:1.6;}
.kyc-banner-actions {display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}
.kyc-cta-primary {background:#E86A18;color:#fff;border:none;border-radius:6px;padding:10px 20px;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none;}
.kyc-cta-primary:hover {background:#d05a10;}
.kyc-cta-secondary {background:#fff;color:#1a2e5a;border:1.5px solid #1a2e5a;border-radius:6px;padding:9px 20px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;}
.kyc-cta-secondary:hover {background:#f0f4ff;}
.kyc-btn-primary {background:#E86A18;color:#fff;border:none;border-radius:6px;padding:10px 22px;font-size:13px;font-weight:700;cursor:pointer;}
.kyc-btn-primary:hover {background:#d05a10;}
.kyc-btn-secondary {background:#fff;color:#1a2e5a;border:2px solid #1a2e5a;border-radius:6px;padding:9px 22px;font-size:13px;font-weight:700;cursor:pointer;}
.kyc-btn-secondary:hover {background:#f0f4ff;}
/* LOGIN MODAL */
.modal-overlay {position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:500;display:none;align-items:center;justify-content:center;}
.modal-overlay.open {display:flex;}
.modal-box {background:#fff;border-radius:12px;padding:36px 32px;width:100%;max-width:380px;box-shadow:0 8px 32px rgba(0,0,0,0.18);position:relative;}
.modal-close {position:absolute;top:14px;right:16px;background:none;border:none;font-size:20px;cursor:pointer;color:#888;line-height:1;}
.modal-close:hover {color:#333;}
.modal-box h2 {font-size:20px;font-weight:700;color:#1a2e5a;margin-bottom:6px;}
.modal-box p {font-size:13px;color:#666;margin-bottom:24px;}
.modal-input {width:100%;border:1.5px solid #ddd;border-radius:6px;padding:11px 14px;font-size:14px;color:#333;outline:none;font-family:Arial,sans-serif;margin-bottom:14px;}
.modal-input:focus {border-color:#1a2e5a;}
.modal-btn {width:100%;background:#1a2e5a;color:#fff;border:none;border-radius:6px;padding:12px;font-size:14px;font-weight:700;cursor:pointer;transition:background 0.15s;}
.modal-btn:hover {background:#162447;}
</style>
