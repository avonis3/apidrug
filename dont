function renderSummary(){
  const cart=JSON.parse(localStorage.getItem('apiCart')||'[]');
  const badge=document.getElementById('cartBadge');
  if(badge) badge.textContent=cart.length||0;
  const itemsEl=document.getElementById('summaryItems');
  if(!cart.length){itemsEl.innerHTML='<div style="color:#888;font-size:13px;">Your cart is empty</div>';return;}
  let subtotal=0,dlTotal=0,discount=0;
  const coupon=localStorage.getItem('apiCoupon');
  const couponPct=coupon==='APILAUNCH10'?10:coupon==='MEDIKA5'?5:0;
  let html='';
  for(const item of cart){
    const found=findSku(item.skuId);
    if(!found)continue;
    const {mol,sku}=found;
    const unitObj=sku.units.find(u=>u.unit===item.unit)||sku.units[0];
    const linePrice=unitObj.price*item.qty;
    subtotal+=linePrice;
    if(item.dataLogger&&sku.dataLogger) dlTotal+=1500;
    const name=mol.molecule.length>28?mol.molecule.slice(0,28)+'...':mol.molecule;
    html+=`<div class="summary-item"><span>${name} (${item.qty} ${item.unit})</span><span>${fmt(linePrice)}</span></div>`;
  }
  if(couponPct) discount=Math.round((subtotal+dlTotal)*couponPct/100);
  const total=subtotal+dlTotal-discount;
  itemsEl.innerHTML=html;
  document.getElementById('subtotalAmt').textContent=fmt(subtotal);
  if(dlTotal){document.getElementById('dlRow').style.display='flex';document.getElementById('dlAmt').textContent=fmt(dlTotal);}
  if(discount){document.getElementById('discountRow').style.display='flex';document.getElementById('discountAmt').textContent='-'+fmt(discount);}
  var deliveryEl=document.getElementById('deliveryRow');
  if(deliveryEl){deliveryEl.style.display='flex';document.getElementById('deliveryAmt').textContent=fmt(DELIVERY_COST);}
  var totalWithDelivery = total + DELIVERY_COST;
  document.getElementById('totalAmt').textContent=fmt(totalWithDelivery);
  localStorage.setItem('apiCheckoutTotal',totalWithDelivery);
}

