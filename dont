var acctUploadedDocs = {};
var ACCT_MANDATORY_DOCS = ['form1929','druglicense','addressproof','gst','pan'];
var ACCT_DEMO_FILENAMES = {form1929:'Form_19-29_Medikabazaar.pdf',druglicense:'Drug_License_WB-2024.pdf',addressproof:'Business_Address_Proof.pdf',gst:'GST_Certificate_27AAFCM.pdf',pan:'PAN_AAFCM3618L.pdf'};

function acctHandleUpload(docId, input){
  if(!input.files||!input.files[0]) return;
  acctMarkUploaded(docId, input.files[0].name);
}
function acctMarkUploaded(docId, filename){
  acctUploadedDocs[docId]=filename;
  var item=document.getElementById('doc-'+docId);
  if(item) item.classList.add('uploaded');
  var fnName=document.getElementById('fn-'+docId+'-name'); if(fnName) fnName.textContent=filename;
  var fn=document.getElementById('fn-'+docId); if(fn) fn.style.display='flex';
  var ub=document.getElementById('ub-'+docId); if(ub) ub.textContent='Change';
  var rb=document.getElementById('rb-'+docId); if(rb) rb.style.display='inline-block';
  acctUpdateProgress();
}
function acctRemoveDoc(docId){
  delete acctUploadedDocs[docId];
  var item=document.getElementById('doc-'+docId); if(item) item.classList.remove('uploaded');
  var fn=document.getElementById('fn-'+docId); if(fn) fn.style.display='none';
  var fi=document.getElementById('fi-'+docId); if(fi) fi.value='';
  var ub=document.getElementById('ub-'+docId); if(ub) ub.textContent='Upload';
  var rb=document.getElementById('rb-'+docId); if(rb) rb.style.display='none';
  acctUpdateProgress();
}
function acctAutoFillAll(){
  Object.keys(ACCT_DEMO_FILENAMES).forEach(function(d){ acctMarkUploaded(d, ACCT_DEMO_FILENAMES[d]); });
  showToast('All documents auto-filled for demo');
}
function acctUpdateProgress(){
  var count=ACCT_MANDATORY_DOCS.filter(function(d){return acctUploadedDocs[d];}).length;
  var pct=(count/ACCT_MANDATORY_DOCS.length)*100;
  var pb=document.getElementById('progressBar'); if(pb){pb.style.width=pct+'%';pb.style.background=count===ACCT_MANDATORY_DOCS.length?'#2e7d32':'#E86A18';}
  var pc=document.getElementById('progressCount'); if(pc) pc.textContent=count+' / '+ACCT_MANDATORY_DOCS.length;
  var sb=document.getElementById('submitBtn'); if(sb) sb.disabled=count<ACCT_MANDATORY_DOCS.length;
}
function acctSubmitKYC(){
  localStorage.setItem('apiKycStatus','pending');
  localStorage.setItem('apiKycSubmittedAt',new Date().toISOString());
  showToast('Documents submitted successfully');
  setTimeout(acctShowKycPending, 500);
}
function acctShowKycPending(){
  document.getElementById('kycUploadPanel').style.display='none';
  document.getElementById('kycPendingPanel').style.display='block';
  document.getElementById('kycApprovedPanel').style.display='none';
  var d=new Date(localStorage.getItem('apiKycSubmittedAt')||new Date().toISOString());
  var sd=document.getElementById('submittedDate');
  if(sd) sd.textContent=d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'})+' at '+d.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true});
  updateSidebarKyc();
}
function acctSimulateApproval(){
  localStorage.setItem('apiKycStatus','approved');
  document.getElementById('kycUploadPanel').style.display='none';
  document.getElementById('kycPendingPanel').style.display='none';
  document.getElementById('kycApprovedPanel').style.display='block';
  showToast('KYC approved (demo simulation)');
  updateSidebarKyc();
}
function acctResetKYC(){
  localStorage.removeItem('apiKycStatus');
  localStorage.removeItem('apiKycSubmittedAt');
  acctUploadedDocs={};
  ACCT_MANDATORY_DOCS.forEach(function(d){
    var item=document.getElementById('doc-'+d); if(item) item.classList.remove('uploaded');
    var fn=document.getElementById('fn-'+d); if(fn) fn.style.display='none';
    var fi=document.getElementById('fi-'+d); if(fi) fi.value='';
    var ub=document.getElementById('ub-'+d); if(ub) ub.textContent='Upload';
    var rb=document.getElementById('rb-'+d); if(rb) rb.style.display='none';
  });
  acctUpdateProgress();
  document.getElementById('kycUploadPanel').style.display='block';
  document.getElementById('kycPendingPanel').style.display='none';
  document.getElementById('kycApprovedPanel').style.display='none';
  updateSidebarKyc();
  showToast('KYC reset - you can submit again');
}

function initAcctKycView(){
  var status=localStorage.getItem('apiKycStatus')||'none';
  if(status==='pending'){
    acctShowKycPending();
  } else if(status==='approved'){
    document.getElementById('kycUploadPanel').style.display='none';
    document.getElementById('kycPendingPanel').style.display='none';
    document.getElementById('kycApprovedPanel').style.display='block';
  } else {
    document.getElementById('kycUploadPanel').style.display='block';
    document.getElementById('kycPendingPanel').style.display='none';
    document.getElementById('kycApprovedPanel').style.display='none';
    acctUpdateProgress();
  }
}

