/* RENDER */
function renderProducts(){
  const q = document.getElementById('localSearch').value.toLowerCase().trim();
  const list = document.getElementById('productList');

  let filtered = ALL_PRODUCTS.filter(p => {
    const catOk = currentCat === 'all' || p.cat === currentCat;
    if(!catOk) return false;
    if(!q) return true;
    return (
      p.molecule.toLowerCase().includes(q) ||
      p.cas.toLowerCase().includes(q) ||
      p.skus.some(s => s.mfr.toLowerCase().includes(q))
    );
  });

  if(filtered.length === 0){
    list.innerHTML = `<div class="empty-state"><h3>No products found</h3><p>Try a different search term or category.</p></div>`;
    renderPagination(0);
    return;
  }

  const paginated = filtered.slice((currentPage-1)*ITEMS_PER_PAGE, currentPage*ITEMS_PER_PAGE);

  list.innerHTML = paginated.map(p => {
    const activeSKUs = p.skus.map(s => ({
      ...s,
      units: s.units.filter(u => u.stock > 0)
    })).filter(s => s.units.length > 0);

    if(activeSKUs.length === 0) return '';

    const rows = activeSKUs.map(s => {
      const u = s.units;
      const unitCells = u.map(unitObj => `
        <tr data-skuid="${s.id}" data-molid="${p.id}">
          <td style="width:180px">${s.mfr}</td>
          <td style="width:90px">${s.grade || '<span style="color:#bbb">-</span>'}</td>
          <td style="width:160px">${s.certs.map(c=>`<a class="cert" href="#" onclick="dlCert('${c}','${p.molecule}');return false;">${c}</a>`).join('')}
          </td>
          <td style="width:70px">${s.purity}</td>
          <td style="width:100px">${s.flag ? `<span class="flag">${s.flag}</span>` : ''}${s.country}</td>
          <td style="width:150px">
            <span class="price">${fmt(unitObj.price)} / ${unitObj.unit}</span>
            <div class="price-incl-gst">Excl. 18% GST</div>
          </td>
          <td style="width:220px;text-align:right">
            <div class="actions">
              <button class="btn-cart" onclick="handleCartClick('${s.id}','${p.id}')">Add to Cart</button>
              <button class="btn-buy" onclick="handleBuyClick('${s.id}','${p.id}')">Buy Now</button>
            </div>
          </td>
        </tr>`).join('');
      return unitCells;
    }).join('');

    return `
      <div class="molecule-card">
        <div class="mol-header">
          <div>
            <div class="mol-name">${p.molecule}</div>
          </div>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead><tr>
              <th style="width:180px">Manufacturer</th>
              <th style="width:90px">Pharmacopeia Grade</th>
              <th style="width:160px">Quality Certificates</th>
              <th style="width:70px">Purity</th>
              <th style="width:100px">Country</th>
              <th style="width:150px">Price (Rs)</th>
              <th style="width:220px;text-align:right">Actions</th>
            </tr></thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      </div>`;
  }).join('');

  renderPagination(filtered.length);
  setTimeout(markAllInCart, 50);
}

/* PAGINATION */
function renderPagination(total){
  const bar = document.getElementById('paginationBar');
  const totalPages = Math.ceil(total / ITEMS_PER_PAGE);
  if(totalPages <= 1){
    bar.innerHTML = '';
    return;
  }
  let html = '';
  html += `<div class="pg-btn-bot" onclick="goPage(${currentPage-1})" style="${currentPage===1?'opacity:0.4;cursor:default':''}">&#8249;</div>`;
  for(let i=1;i<=totalPages;i++){
    html += `<div class="pg-num-bot${i===currentPage?' active':''}" onclick="goPage(${i})">${i}</div>`;
  }
  html += `<div class="pg-btn-bot" onclick="goPage(${currentPage+1})" style="${currentPage===totalPages?'opacity:0.4;cursor:default':''}">&#8250;</div>`;
  bar.innerHTML = html;
}

function goPage(n){
  const q = document.getElementById('localSearch').value.toLowerCase().trim();
  const filtered = ALL_PRODUCTS.filter(p => {
    const catOk = currentCat === 'all' || p.cat === currentCat;
    if(!catOk) return false;
    if(!q) return true;
    return (
      p.molecule.toLowerCase().includes(q) ||
      p.cas.toLowerCase().includes(q) ||
      p.skus.some(s => s.mfr.toLowerCase().includes(q))
    );
  });
  const totalPages = Math.ceil(filtered.length / ITEMS_PER_PAGE);
  if(n < 1 || n > totalPages) return;
  currentPage = n;
  renderProducts();
  window.scrollTo({top:0,behavior:'smooth'});
}

