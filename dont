function removeItem(idx){
  const cart = getCart();
  cart.splice(idx,1);
  saveCart(cart);
  render();
  showToast('Item removed from cart');
}

function changeQty(idx, delta){
  const cart = getCart();
  const item = cart[idx];
  const ref = findSKU(item.skuId);
  if(!ref) return;
  const unitObj = ref.sku.units.find(u=>u.unit===item.unit);
  const max = unitObj ? unitObj.stock : 9999;
  item.qty = Math.max(1, Math.min(item.qty + delta, max));
  saveCart(cart);
  render();
}

function setQty(idx, val){
  const cart = getCart();
  const item = cart[idx];
  const ref = findSKU(item.skuId);
  if(!ref) return;
  const unitObj = ref.sku.units.find(u=>u.unit===item.unit);
  const max = unitObj ? unitObj.stock : 9999;
  item.qty = Math.max(1, Math.min(parseInt(val)||1, max));
  saveCart(cart);
  render();
}

function changeUnit(idx, unit, price){
  const cart = getCart();
  cart[idx].unit = unit;
  cart[idx].price = price;
  cart[idx].qty = 1;
  saveCart(cart);
  render();
}

function toggleDL(idx, checked){
  const cart = getCart();
  cart[idx].dlEnabled = checked;
  saveCart(cart);
  render();
}

function applyCoupon(){
  const code = document.getElementById('couponInput').value.trim().toUpperCase();
  if(!code){ showToast('Please enter a coupon code'); return; }
  if(VALID_COUPONS[code]){
    couponApplied = true;
    couponDiscount = VALID_COUPONS[code];
    couponCode = code;
    showToast(`Coupon "${code}" applied: ${couponDiscount}% off!`);
    render();
  } else {
    showToast('Invalid or expired coupon code');
  }
}

function proceedCheckout(){
  if(localStorage.getItem('apiLoggedIn')!=='1'){ showToast('Please login to proceed'); return; }
  const cart=getCart(); if(!cart.length){ showToast('Your cart is empty'); return; }
  const subtotal=cart.reduce((s,i)=>s+(i.price*i.qty),0);
  const dlTotal=cart.reduce((s,i)=>s+(i.dlEnabled?DL_PRICE:0),0);
  const discountAmt=couponApplied?Math.round((subtotal+dlTotal)*couponDiscount/100):0;
  const preGst=subtotal+dlTotal-discountAmt;
  const gst=Math.round(preGst*0.12);
  const totalInclGst=preGst+gst;
  localStorage.setItem('apiCheckoutTotal', totalInclGst);
  showScreen('screen-checkout');
}



function updateSummaryTotal(){
  const cart=getCart();
  const subtotal=cart.reduce((s,i)=>s+(i.price*i.qty),0);
  const dlTotal=cart.reduce((s,i)=>s+(i.dlEnabled?DL_PRICE:0),0);
  const discountAmt=couponApplied?Math.round((subtotal+dlTotal)*couponDiscount/100):0;
  const preGst=subtotal+dlTotal-discountAmt;
  const gst=Math.round(preGst*0.12);
  const totalInclGst=preGst+gst;
  const fmt=v=>'\u20B9'+v.toLocaleString('en-IN');
  const elTotal=document.getElementById('summaryTotal');
  if(elTotal) elTotal.textContent=fmt(totalInclGst);
  const elGst=document.getElementById('gstAmt');
  if(elGst) elGst.textContent=fmt(gst);
  const clRow=document.getElementById('creditLineRow');
  if(clRow) clRow.style.display=useCreditLine?'flex':'none';
  // save GST-inclusive total for checkout page
  localStorage.setItem('apiCheckoutTotal',totalInclGst);
  if(useCreditLine) localStorage.setItem('apiPaymentMethod','credit');
  else localStorage.removeItem('apiPaymentMethod');
}

