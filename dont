/* CONFIRM POPUP */
function openConfirmPopup(skuId, molId, action){
  const mol = ALL_PRODUCTS.find(p=>p.id==molId);
  const sku = mol.skus.find(s=>s.id===skuId);
  var availUnitsBase = sku.units.filter(u=>u.stock>0);
  // Inject Ton unit derived from KG if not already present
  var hasTon = availUnitsBase.some(u=>u.unit==='Ton');
  var kgUnit = availUnitsBase.find(u=>u.unit==='KG');
  var availUnits = availUnitsBase.slice();
  if(!hasTon && kgUnit){
    availUnits = availUnits.concat([{unit:'Ton', price: kgUnit.price * 1000, stock: kgUnit.stock}]);
  }

  popupContext = {sku, mol, action, availUnits, selectedUnit: availUnits[0]};

  document.getElementById('popupTitle').textContent = action==='cart' ? 'Add to Cart' : 'Buy Now';
  document.getElementById('popupMol').textContent = mol.molecule + ', ' + sku.mfr;
  document.getElementById('qtyInput').value = 1;

  const unitOpts = document.getElementById('unitOptions');
  unitOpts.innerHTML = availUnits.map((u,i)=>`
    <div class="unit-opt ${i===0?'selected':''}" onclick="selectUnit(${i})">${u.unit}</div>
  `).join('');

  updatePopupPrice();
  document.getElementById('confirmPopup').classList.add('open');
}

function selectUnit(idx){
  popupContext.selectedUnit = popupContext.availUnits[idx];
  document.querySelectorAll('.unit-opt').forEach((el,i)=>el.classList.toggle('selected',i===idx));
  document.getElementById('qtyUnitLabel').textContent = popupContext.selectedUnit.unit;
  document.getElementById('qtyMaxLabel').textContent = 'Max: ' + popupContext.selectedUnit.stock.toLocaleString('en-IN') + ' ' + popupContext.selectedUnit.unit;
  updatePopupPrice();
}

function updatePopupPrice(){
  if(!popupContext) return;
  const qty = parseInt(document.getElementById('qtyInput').value)||1;
  const {selectedUnit} = popupContext;
  const maxQ = selectedUnit.stock;
  if(qty > maxQ){
    document.getElementById('qtyInput').value = maxQ;
  }
  const safeQty = Math.min(qty, maxQ);
  const total = safeQty * selectedUnit.price;
  document.getElementById('qtyUnitLabel').textContent = selectedUnit.unit;
  document.getElementById('qtyMaxLabel').textContent = 'Max: ' + maxQ.toLocaleString('en-IN') + ' ' + selectedUnit.unit;
  document.getElementById('popupPrice').textContent = 'Total: ₹' + total.toLocaleString('en-IN') + ' (excl. GST)';
}

function closePopup(){
  document.getElementById('confirmPopup').classList.remove('open');
  popupContext=null;
}

function confirmAddToCart(){
  const qty = parseInt(document.getElementById('qtyInput').value)||1;
  const {sku, mol, selectedUnit} = popupContext;
  const cart = JSON.parse(localStorage.getItem('apiCart')||'[]');
  const existing = cart.find(i=>i.skuId===sku.id && i.unit===selectedUnit.unit);
  if(existing){
    existing.qty = Math.min(existing.qty+qty, selectedUnit.stock);
  } else {
    cart.push({
      skuId: sku.id, molId: mol.id, molecule: mol.molecule,
      mfr: sku.mfr, unit: selectedUnit.unit, qty,
      price: selectedUnit.price, cas: mol.cas,
      grade: sku.grade
    });
  }
  localStorage.setItem('apiCart', JSON.stringify(cart));
  updateCartBadge();
  markInCart(sku.id);
  closePopup();
  showToast(mol.molecule + ' (' + qty + ' ' + selectedUnit.unit + ') added to cart');
}

function markInCart(skuId){
  document.querySelectorAll(`[data-skuid="${skuId}"] .btn-cart`).forEach(btn=>{
    btn.textContent='Go to Cart';
    btn.style.background='#1a2e5a';
    btn.style.color='#fff';
    btn.style.border='1.5px solid #1a2e5a';
    btn.onclick=()=>showScreen('screen-cart');
  });
}

function confirmBuyNow(){
  confirmAddToCart();
  showScreen('screen-cart');
}

